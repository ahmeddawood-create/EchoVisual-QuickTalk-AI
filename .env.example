# Copy this file to .env and paste your real key. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the model (defaults to gemini-3.5-flash-lite in main.py)
GEMINI_MODEL=gemini-3.5-flash-lite

# Edge-TTS neural voices (free, human-quality speech — no API key needed)
# Optional: override the voices used for English / Urdu speech
EDGE_TTS_VOICE_EN=en-US-ChristopherNeural
EDGE_TTS_VOICE_UR=ur-PK-AsadNeural

# Groq API (free Urdu speech-to-text via Whisper — get key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the Whisper model (defaults to whisper-large-v3-turbo)
GROQ_STT_MODEL=whisper-large-v3-turbo
